# 이 파일을 .env로 복사해 값을 채운다. .env는 Git에 올리지 않는다.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=dozy_inventory
DB_USERNAME=root
DB_PASSWORD=
SERVER_PORT=8082
# Outbox 이벤트를 발행할 Kafka. docker compose의 로컬 Kafka가 기본값이다
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AUTH_ISSUER_BASE_URI=http://localhost:8081
# 대사 배치가 호출할 WMS 주소(ADR-0033). 비어 있으면 대사 실행이 실패로 기록된다
WMS_BASE_URL=
# WMS를 system client 토큰으로 호출하려면 켜고 dozy-auth에 등록한 inventory의 client 자격을 넣는다. 비밀은 커밋하지 않는다
AUTH_CLIENT_ENABLED=false
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# 운영 환경은 SPRING_PROFILES_ACTIVE=prod로 띄우고 위 값(DB_*, KAFKA_BOOTSTRAP_SERVERS, AUTH_ISSUER_BASE_URI)을 모두 넣어야 한다. 전체 목록은 docs/configuration.md
# local 프로필은 토큰 없이 고정 개발 사용자로 동작한다. 운영 환경에 설정하지 않는다.
SPRING_PROFILES_ACTIVE=local
