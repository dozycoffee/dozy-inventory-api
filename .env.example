# 이 파일을 .env로 복사해 값을 채운다. .env는 Git에 올리지 않는다.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=dozy_inventory
DB_USERNAME=root
DB_PASSWORD=
SERVER_PORT=8082
# Outbox 이벤트를 발행할 Kafka. docker compose의 로컬 Kafka가 기본값이다
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AUTH_ISSUER_BASE_URI=http://localhost:8081
# local 프로필은 토큰 없이 고정 개발 사용자로 동작한다. 운영 환경에 설정하지 않는다.
SPRING_PROFILES_ACTIVE=local
